#include <stdio.h>
#include <stdlib.h>

#define MAX_MSG 100
#define COLS 7

int receiver[MAX_MSG + 1][COLS + 1];
int ROWS;

void readFromChannel();
void introduceError();
void displayReceiver();
void checkParity();
void decodeMessage();

void readFromChannel()
{
    FILE *fp;
    int i, j, cols;

    fp = fopen("channel.txt", "r");

    if(fp == NULL)
    {
        printf("\nError: channel.txt not found. Run sender first.\n");
        exit(1);
    }

    if(fscanf(fp, "%d %d", &ROWS, &cols) != 2)
    {
        printf("Error reading dimensions from channel.txt\n");
        fclose(fp);
        exit(1);
    }

    for(i = 0; i <= ROWS; i++)
    {
        for(j = 0; j <= COLS; j++)
        {
            if(fscanf(fp, "%d", &receiver[i][j]) != 1)
            {
                printf("Error reading channel.txt\n");
                fclose(fp);
                exit(1);
            }
        }
    }

    fclose(fp);

    printf("\nMatrix received from channel (%d x %d data + parity row/col):\n\n", ROWS, COLS);

    for(i = 0; i <= ROWS; i++)
    {
        for(j = 0; j <= COLS; j++)
        {
            printf("%d ", receiver[i][j]);
        }
        printf("\n");
    }
}

void introduceError()
{
    int choice;
    int errors;
    int row, col;
    int i, j;
    int errorRow[20], errorCol[20];
    int duplicate;

    printf("\nDo you want to introduce error(s)?\n");
    printf("1. Yes\n");
    printf("2. No\n");
    printf("Enter Choice : ");
    scanf("%d", &choice);

    if(choice == 1)
    {
        printf("Enter number of errors: ");
        scanf("%d", &errors);

        printf("\nNote: Enter different positions for each error.\n");

        for(i = 0; i < errors; i++)
        {
            while(1)
            {
                printf("\nError %d\n", i + 1);

                printf("Enter Row (1-%d): ", ROWS);
                scanf("%d", &row);

                printf("Enter Column (1-%d): ", COLS);
                scanf("%d", &col);

                row--;
                col--;

                if(row < 0 || row >= ROWS || col < 0 || col >= COLS)
                {
                    printf("Invalid Position. Try again.\n");
                    continue;
                }

                duplicate = 0;

                for(j = 0; j < i; j++)
                {
                    if(errorRow[j] == row && errorCol[j] == col)
                    {
                        duplicate = 1;
                        break;
                    }
                }

                if(duplicate)
                {
                    printf("Position already selected. Enter a different position.\n");
                    continue;
                }

                errorRow[i] = row;
                errorCol[i] = col;

                receiver[row][col] ^= 1;
                break;
            }
        }
    }
}

void displayReceiver()
{
    int i, j;

    printf("\nReceiver Matrix:\n\n");

    for(i = 0; i <= ROWS; i++)
    {
        for(j = 0; j <= COLS; j++)
        {
            printf("%d ", receiver[i][j]);
        }
        printf("\n");
    }
}

void checkParity()
{
    int i, j;
    int count;
    int rowErrors[MAX_MSG];
    int colErrors[COLS];
    int rowCount = 0;
    int colCount = 0;

    /* Check Row Parity */

    for(i = 0; i < ROWS; i++)
    {
        count = 0;

        for(j = 0; j < COLS; j++)
        {
            if(receiver[i][j] == 1)
                count++;
        }

        if((count % 2) != receiver[i][COLS])
        {
            rowErrors[rowCount] = i;
            rowCount++;
        }
    }

    /* Check Column Parity */

    for(j = 0; j < COLS; j++)
    {
        count = 0;

        for(i = 0; i < ROWS; i++)
        {
            if(receiver[i][j] == 1)
                count++;
        }

        if((count % 2) != receiver[ROWS][j])
        {
            colErrors[colCount] = j;
            colCount++;
        }
    }

    if(rowCount == 0 && colCount == 0)
    {
        printf("\nData received without error.\n");
    }
    else if(rowCount == 1 && colCount == 1)
    {
        printf("\nSingle Bit Error Detected.\n");
        printf("Error Position : Row %d Column %d\n",
               rowErrors[0] + 1, colErrors[0] + 1);

        receiver[rowErrors[0]][colErrors[0]] ^= 1;

        printf("\nError Corrected Successfully.\n");

        printf("\nCorrected Matrix:\n");

        for(i = 0; i <= ROWS; i++)
        {
            for(j = 0; j <= COLS; j++)
                printf("%d ", receiver[i][j]);
            printf("\n");
        }
    }
    else
    {
        printf("\nMultiple Bit Errors Detected.\n");
        printf("Error cannot be corrected using 2D Parity.\n");

        printf("\nRows with parity mismatch   : ");
        if(rowCount == 0)
            printf("none");
        else
            for(i = 0; i < rowCount; i++)
                printf("%d ", rowErrors[i] + 1);

        printf("\nColumns with parity mismatch: ");
        if(colCount == 0)
            printf("none");
        else
            for(j = 0; j < colCount; j++)
                printf("%d ", colErrors[j] + 1);

        printf("\n");
    }
}

void decodeMessage()
{
    int i, j;
    unsigned char ch;

    printf("\nDecoded Message: ");

    for(i = 0; i < ROWS; i++)
    {
        ch = 0;
        for(j = 0; j < COLS; j++)          
        {
            ch = (ch << 1) | receiver[i][j];
        }
        printf("%c", ch);
    }
    printf("\n");
}

int main()
{
    readFromChannel();
    introduceError();
    displayReceiver();
    checkParity();
    decodeMessage();

    return 0;
}


#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define MAX 100

char received[MAX];
char original[MAX];

int dataBits;
int parityBits;
int totalBits;

void readFromChannel();
void receiveCode();
void getCoveredPositions(int position, int covered[], int *count);
void detectAndCorrect();
void extractOriginalData();
void displayReceiver();
void decodeMessage();

int isPowerOfTwo(int n);

int main()
{
    printf("\n========================================");
    printf("\n        HAMMING CODE - RECEIVER");
    printf("\n========================================\n");

    readFromChannel();

    receiveCode();

    detectAndCorrect();

    extractOriginalData();

    displayReceiver();

    decodeMessage();

    return 0;
}

int isPowerOfTwo(int n)
{
    if(n == 1)
        return 1;

    while(n > 1)
    {
        if(n % 2 != 0)
            return 0;

        n /= 2;
    }

    return 1;
}

void readFromChannel()
{
    FILE *fp;
    char sentCode[MAX];
    int i;

    fp = fopen("channel.txt", "r");

    if(fp == NULL)
    {
        printf("\nError: channel.txt not found. Run sender first.\n");
        exit(1);
    }

    fscanf(fp, "%s", &sentCode[1]);

    fclose(fp);

    totalBits = strlen(&sentCode[1]);

    /* Derive parityBits/dataBits purely from totalBits: minimal p such
       that 2^p >= totalBits + 1, same relationship the sender used. */
    parityBits = 0;
    while(pow(2, parityBits) < (totalBits + 1))
        parityBits++;

    dataBits = totalBits - parityBits;

    printf("\nData Bits   : %d", dataBits);
    printf("\nParity Bits : %d", parityBits);
    printf("\nTotal Bits  : %d\n", totalBits);

    printf("\nHamming Code received from channel : ");

    for(i = 1; i <= totalBits; i++)
        printf("%c", sentCode[i]);

    printf("\n");
}

void receiveCode()
{
    printf("\n====================================");
    printf("\n        HAMMING RECEIVER");
    printf("\n====================================");

    printf("\nEnter Received Hamming Code : ");

    scanf("%s", &received[1]);

    received[totalBits + 1] = '\0';
}

/* Computes which bit positions a parity bit at "position" covers.
   Includes the parity bit's own position in the list (it is part
   of the group being summed for the check), same logic as sender. */
void getCoveredPositions(int position, int covered[], int *count)
{
    int j, k;

    *count = 0;

    for(j = position; j <= totalBits; j += 2 * position)
    {
        for(k = j; k < j + position && k <= totalBits; k++)
        {
            covered[*count] = k;
            (*count)++;
        }
    }
}

void detectAndCorrect()
{
    int i, k;
    int parity;
    int errorPosition = 0;
    int covered[MAX], coveredCount;

    printf("\n\nChecking Parity Bits...\n");

    for(i = 0; i < parityBits; i++)
    {
        int position = (int)pow(2, i);

        getCoveredPositions(position, covered, &coveredCount);

        printf("\nP%d (Position %d) depends on bit positions : ", position, position);
        for(k = 0; k < coveredCount; k++)
        {
            if(covered[k] != position)
                printf("%d ", covered[k]);
        }
        printf("\n");

        parity = 0;

        for(k = 0; k < coveredCount; k++)
        {
            if(received[covered[k]] == '1')
                parity++;
        }

        parity = parity % 2;

        printf("Parity Bit P%d : %d\n", position, parity);

        if(parity != 0)
        {
            errorPosition += position;
        }
    }

    if(errorPosition == 0)
    {
        printf("\n\nNo Error Detected.\n");
    }
    else if(errorPosition > totalBits)
    {
        printf("\nMultiple Bit Errors Detected (position %d is outside the code).\n", errorPosition);
        printf("This cannot be corrected with single-bit Hamming code.\n");
    }
    else
    {
        printf("\nError Detected at Bit Position : %d\n", errorPosition);

        if(received[errorPosition] == '0')
            received[errorPosition] = '1';
        else
            received[errorPosition] = '0';

        printf("Error Corrected Successfully.\n");
    }
}

void extractOriginalData()
{
    int i;
    int j = 0;

    for(i = 1; i <= totalBits; i++)
    {
        if(!isPowerOfTwo(i))
        {
            original[j] = received[i];
            j++;
        }
    }

    original[j] = '\0';
}

void displayReceiver()
{
    int i;

    printf("\n====================================");
    printf("\n          FINAL OUTPUT");
    printf("\n====================================");

    printf("\nCorrected Hamming Code : ");

    for(i = 1; i <= totalBits; i++)
        printf("%c", received[i]);

    printf("\n");

    printf("\nPosition-wise view:\n");

    printf("Position : ");
    for(i = totalBits; i >= 1; i--)
        printf("%3d", i);
    printf("\n");

    printf("Bit      : ");
    for(i = totalBits; i >= 1; i--)
        printf("%3c", received[i]);
    printf("\n");

    printf("\nOriginal Data : %s\n", original);
}

void decodeMessage()
{
    int i, b;
    unsigned char ch;
    int len = dataBits / 8;

    if(dataBits % 8 != 0)
    {
        printf("\n(Data bits are not a multiple of 8, skipping text decode.)\n");
        return;
    }

    printf("\nDecoded Message : ");

    for(i = 0; i < len; i++)
    {
        ch = 0;
        for(b = 0; b < 8; b++)
        {
            ch = (ch << 1) | (original[i * 8 + b] - '0');
        }
        printf("%c", ch);
    }
    printf("\n");
}
